# Set environment variables in the process that starts Tomcat.
# This file is a reference; the application does not automatically load .env files.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=WebExamDB;encrypt=true;trustServerCertificate=true;sslProtocol=TLSv1.2;loginTimeout=5;socketTimeout=10000
DB_USER=sa
DB_PASSWORD=YOUR_DATABASE_PASSWORD
SMTP_USER=YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
